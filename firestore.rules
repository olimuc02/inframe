rules_version = '2';
// InFrame rules: you must be logged in (Firebase Authentication) to read or change anything.
// Profiles can only be created/edited by their owner. The admin profile ("admin_<uid>", isAdmin: true)
// can only be created or changed by someone signed in with Google as the admin email.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'muckadigital@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /inframe_users/{id} {
      allow read: if signedIn();
      allow delete: if signedIn() && (id == request.auth.uid || isAdmin());
      allow create, update: if signedIn()
        && request.resource.data.username is string
        && request.resource.data.first is string && request.resource.data.first.size() <= 40
        && ((id == request.auth.uid && request.resource.data.get('isAdmin', false) == false) || isAdmin());
    }
    match /inframe_usernames/{name} {
      allow read: if signedIn();
      // one person per username: a name can only be taken if it's free, and only its owner can change it
      allow create: if signedIn() && name.matches('^[a-z0-9._]{3,20}$')
        && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if signedIn() && name.matches('^[a-z0-9._]{3,20}$')
        && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    // username log-in records: email encrypted with the owner's password; readable one at a time, never listable
    match /inframe_logins/{name} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/inframe_usernames/$(name)).data.userId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /inframe_groups/{id} { allow read, write: if signedIn(); }
    match /inframe_events/{id} { allow read, write: if signedIn(); }
    match /inframe_photos/{id} { allow read, write: if signedIn(); }
    match /inframe_images/{id} { allow read, write: if signedIn(); }
    // short videos, saved in pieces under 1 MB each
    match /inframe_vchunks/{id} { allow read, write: if signedIn(); }
    match /inframe_deliveries/{id} { allow read, write: if signedIn(); }
    match /inframe_notifications/{id} { allow read, write: if signedIn(); }
    match /inframe_requests/{id} { allow read, write: if signedIn(); }
    // private asks to take a photo down, sent to group admins / event owner and the poster
    match /inframe_removals/{id} { allow read, write: if signedIn(); }
    // running total of storage used (just numbers)
    match /inframe_stats/{id} { allow read, write: if signedIn(); }
  }
}
